{
	"name": "pi-ask-user-cz",
	"version": "0.1.0",
	"description": "Pi extension. Fork of @juicesharp/rpiv-ask-user-question: the ask_user_question questionnaire with Czech chrome and content, while the model keeps authoring and receiving English. Content is translated through pi-prompt-translate-czk; previews and the user's own text are never translated.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"czech"
	],
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./events": "./events.ts"
	},
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "npm run typecheck && node scripts/run-tests.mjs"
	},
	"files": [
		"ask-user-question.ts",
		"config-support.ts",
		"config.ts",
		"events.ts",
		"index.ts",
		"prompt-events.ts",
		"reconcile.ts",
		"rpc-fallback.ts",
		"session-factory.ts",
		"translate-blocks.ts",
		"translate-questionnaire.ts",
		"LICENSE",
		"locales/cs.json",
		"README.md",
		"state/build-questionnaire.ts",
		"state/external-editor.ts",
		"state/i18n-bridge.ts",
		"state/key-router.ts",
		"state/questionnaire-session.ts",
		"state/row-intent.ts",
		"state/selectors/contract.ts",
		"state/selectors/derivations.ts",
		"state/selectors/focus.ts",
		"state/selectors/projections.ts",
		"state/state-reducer.ts",
		"state/state.ts",
		"tool/format-answer.ts",
		"tool/normalize-params.ts",
		"tool/prompt-copy.ts",
		"tool/response-envelope.ts",
		"tool/types.ts",
		"tool/validate-questionnaire.ts",
		"view/component-binding.ts",
		"view/components/inline-input.ts",
		"view/components/multi-select-view.ts",
		"view/components/option-list-view.ts",
		"view/components/preview/markdown-content-cache.ts",
		"view/components/preview/preview-block-renderer.ts",
		"view/components/preview/preview-box-renderer.ts",
		"view/components/preview/preview-layout-decider.ts",
		"view/components/preview/preview-pane.ts",
		"view/components/submit-picker.ts",
		"view/components/tab-bar.ts",
		"view/components/wrapping-select.ts",
		"view/dialog-builder.ts",
		"view/props-adapter.ts",
		"view/stateful-view.ts",
		"view/tab-components.ts",
		"view/tab-content-strategy.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"author": "mastnacek",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mastnacek/pi-ask-user-cz.git"
	},
	"homepage": "https://github.com/mastnacek/pi-ask-user-cz#readme",
	"bugs": {
		"url": "https://github.com/mastnacek/pi-ask-user-cz/issues"
	}
}
