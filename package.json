{
	"name": "pi-ask-user-cz",
	"version": "0.1.0",
	"description": "Pi extension. Fork of @juicesharp/rpiv-ask-user-question: the ask_user_question questionnaire with Czech chrome and content, while the model keeps authoring and receiving English. Content is translated through pi-prompt-translate-czk; previews and the user's own text are never translated.",
	"keywords": [
		"pi-package",
		"pi-extension",
		"czech"
	],
	"type": "module",
	"exports": {
		".": "./index.ts",
		"./events": "./src/shared/contract.ts"
	},
	"license": "MIT",
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "npm run typecheck && node scripts/smoke.mjs && node scripts/run-tests.mjs",
		"smoke": "node scripts/smoke.mjs"
	},
	"files": [
		"index.ts",
		"locales/cs.json",
		"src/shared/config-source.ts",
		"src/shared/config.ts",
		"src/shared/contract.ts",
		"src/shared/i18n.ts",
		"src/slices/questionnaire/params/envelope.ts",
		"src/slices/questionnaire/params/format.ts",
		"src/slices/questionnaire/params/normalize.ts",
		"src/slices/questionnaire/params/prompt-copy.ts",
		"src/slices/questionnaire/params/types.ts",
		"src/slices/questionnaire/params/validate.ts",
		"src/slices/questionnaire/prompt-events.ts",
		"src/slices/questionnaire/rpc-fallback.ts",
		"src/slices/questionnaire/session-factory.ts",
		"src/slices/questionnaire/session/build.ts",
		"src/slices/questionnaire/session/external-editor.ts",
		"src/slices/questionnaire/session/key-router.ts",
		"src/slices/questionnaire/session/questionnaire.ts",
		"src/slices/questionnaire/session/reducer.ts",
		"src/slices/questionnaire/session/row-intent.ts",
		"src/slices/questionnaire/session/selectors/contract.ts",
		"src/slices/questionnaire/session/selectors/derivations.ts",
		"src/slices/questionnaire/session/selectors/focus.ts",
		"src/slices/questionnaire/session/selectors/projections.ts",
		"src/slices/questionnaire/session/state.ts",
		"src/slices/questionnaire/tool.ts",
		"src/slices/questionnaire/translate-blocks.ts",
		"src/slices/questionnaire/translate.ts",
		"src/slices/questionnaire/view/component-binding.ts",
		"src/slices/questionnaire/view/components/inline-input.ts",
		"src/slices/questionnaire/view/components/multi-select-view.ts",
		"src/slices/questionnaire/view/components/option-list-view.ts",
		"src/slices/questionnaire/view/components/preview/markdown-content-cache.ts",
		"src/slices/questionnaire/view/components/preview/preview-block-renderer.ts",
		"src/slices/questionnaire/view/components/preview/preview-box-renderer.ts",
		"src/slices/questionnaire/view/components/preview/preview-layout-decider.ts",
		"src/slices/questionnaire/view/components/preview/preview-pane.ts",
		"src/slices/questionnaire/view/components/submit-picker.ts",
		"src/slices/questionnaire/view/components/tab-bar.ts",
		"src/slices/questionnaire/view/components/wrapping-select.ts",
		"src/slices/questionnaire/view/dialog-builder.ts",
		"src/slices/questionnaire/view/props-adapter.ts",
		"src/slices/questionnaire/view/stateful-view.ts",
		"src/slices/questionnaire/view/tab-components.ts",
		"src/slices/questionnaire/view/tab-content-strategy.ts",
		"src/slices/reconcile/index.ts"
	],
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"author": "mastnacek",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mastnacek/pi-ask-user-cz.git"
	},
	"homepage": "https://github.com/mastnacek/pi-ask-user-cz#readme",
	"bugs": {
		"url": "https://github.com/mastnacek/pi-ask-user-cz/issues"
	}
}
